<%- include('partials/head') %>
<section class="card narrow">
  <h1><%= error.status %> <%= { 400: '잘못된 요청', 401: '로그인 필요', 403: '권한 없음', 404: '찾을 수 없음', 409: '처리할 수 없음' }[error.status] || '오류' %></h1>
  <p>
    <span class="badge code"><%= error.code %></span>
    <% if (error.details && error.details.rule) { %><span class="badge code"><%= error.details.rule %></span><% } %>
    <%= error.message %>
  </p>
  <% if (error.status === 403) { %>
    <p class="hint">화면에서 메뉴를 숨기는 것과 별개로, 서버가 모든 요청의 권한을 다시 검사합니다 (NFR-03, BR-09). 이 시도는 보안 이벤트로 기록됩니다.</p>
  <% } %>
  <p><a href="javascript:history.back()">← 뒤로</a> · <a href="/">홈으로</a></p>
</section>
<%- include('partials/foot') %>
