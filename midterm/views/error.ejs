<%- include('partials/head') %>
<% const titles = { 400: '요청을 처리할 수 없습니다', 401: '로그인이 필요합니다', 403: '접근 권한이 없습니다', 404: '페이지를 찾을 수 없습니다', 409: '지금 상태에서는 처리할 수 없습니다' }; %>
<section class="card error-box">
  <div class="status"><%= error.status %></div>
  <h1><%= titles[error.status] || '오류가 발생했습니다' %></h1>
  <p><%= error.message %><% if (error.details && error.details.rule) { %> <span class="flash-code">규정 <%= error.details.rule %></span><% } %></p>
  <% if (error.status === 403) { %>
    <p class="muted small">필요한 권한이 없는 화면입니다. 이 접근 시도는 보안 기록에 남습니다. 권한이 필요하면 시스템 관리자에게 문의하세요.</p>
  <% } %>
  <p class="page-actions" style="justify-content:center"><a class="button ghost" href="javascript:history.back()">이전 화면</a><a class="button" href="/"><%= me ? '업무 홈' : '로그인' %></a></p>
</section>
<%- include('partials/foot') %>
