<%- include('partials/head') %>
<%- include('partials/crumbs') %>
<div class="page-head">
  <div>
    <h1>역할 변경 요청</h1>
    <p class="page-desc"><%= me.role === 'CAPO' ? '내가 추천한 소속원의 역할 변경 요청과 처리 결과입니다. 추천은 구성원 화면에서 합니다.' : 'Capo가 추천한 역할 변경을 검토해 승인하거나 거절합니다.' %></p>
  </div>
</div>

<section class="card">
  <form method="get" action="/role-requests" class="form-row filters">
    <label>상태
      <select name="status">
        <option value="">전체</option>
        <% Object.entries(C.REQUEST_STATUS_INFO).forEach(([key, info]) => { %>
          <option value="<%= key %>" <%= query.status === key ? 'selected' : '' %>><%= info.label %></option>
        <% }) %>
      </select>
    </label>
    <button>조회</button>
  </form>

  <div class="table-wrap">
    <table>
      <thead><tr><th>대상</th><th>역할 변경</th><th>사유</th><th>요청자</th><th>요청일</th><th>상태</th><th>처리</th></tr></thead>
      <tbody>
        <% requests.forEach((r) => { %>
          <tr>
            <td><%- include('partials/who', { u: r.user }) %></td>
            <td><%= r.fromRoleLabel %> → <strong><%= r.toRoleLabel %></strong></td>
            <td class="small"><%= r.reason %></td>
            <td><%- include('partials/who', { u: r.requestedBy }) %></td>
            <td class="small"><%= fmt(r.createdAt) %></td>
            <td><span class="badge"><%= r.statusLabel %></span></td>
            <td>
              <% if (r.status === 'PENDING' && can('roleRequest.review')) { %>
                <form method="post" action="/role-requests/<%= r.id %>/approve"><button class="small">승인</button></form>
                <form method="post" action="/role-requests/<%= r.id %>/reject">
                  <input name="reason" required placeholder="거절 사유" maxlength="500">
                  <button class="ghost small">거절</button>
                </form>
              <% } else if (r.status !== 'PENDING') { %>
                <span class="small muted"><%= r.decidedBy ? r.decidedBy.name : '' %> <%= fmt(r.decidedAt) %><%= r.decisionReason ? ' · ' + r.decisionReason : '' %></span>
              <% } else { %>
                <span class="small muted">승인 대기</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
        <% if (!requests.length) { %><tr><td colspan="7" class="empty">요청이 없습니다.</td></tr><% } %>
      </tbody>
    </table>
  </div>
  <%- include('partials/pager', { meta }) %>
  <% if (can('roleRequest.review')) { %><p class="hint">승인하면 그 시점의 역할 기준으로 다시 확인한 뒤 역할이 바뀝니다. 자신이 한 요청은 승인할 수 없습니다.</p><% } %>
</section>
<%- include('partials/foot') %>
