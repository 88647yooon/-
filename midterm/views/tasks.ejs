<%- include('partials/head') %>
<h1>업무 <span class="tag">FR-07 · FR-12</span></h1>

<section class="card">
  <form method="get" action="/tasks" class="form-row">
    <label>검색 <input name="q" value="<%= query.q || '' %>" placeholder="제목·설명·장소"></label>
    <label>상태
      <select name="status">
        <option value="">전체</option>
        <% Object.entries(C.TASK_STATUS_INFO).forEach(([key, info]) => { %><option value="<%= key %>" <%= query.status === key ? 'selected' : '' %>><%= info.label %></option><% }) %>
      </select>
    </label>
    <label>중요도
      <select name="priority">
        <option value="">전체</option>
        <% Object.entries(C.TASK_PRIORITY_INFO).forEach(([key, info]) => { %><option value="<%= key %>" <%= query.priority === key ? 'selected' : '' %>><%= info.label %></option><% }) %>
      </select>
    </label>
    <% if (me.role !== 'CAPO') { %>
      <label>Crew
        <select name="crewId">
          <option value="">전체</option>
          <% crews.forEach((c) => { %><option value="<%= c.id %>" <%= query.crewId === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %>
        </select>
      </label>
    <% } %>
    <label>정렬
      <select name="sort">
        <% [['startAt', '일정 빠른 순'], ['-startAt', '일정 늦은 순'], ['-priority', '중요도 높은 순'], ['-createdAt', '최근 등록순']].forEach(([value, label]) => { %>
          <option value="<%= value %>" <%= query.sort === value ? 'selected' : '' %>><%= label %></option>
        <% }) %>
      </select>
    </label>
    <button>조회</button>
  </form>
  <p class="hint"><%= me.role === 'CAPO' ? 'Capo는 자신이 책임자인 Crew의 업무만 봅니다.' : 'Underboss·Boss는 모든 Crew 업무와 조직 업무를 봅니다.' %></p>

  <div class="table-wrap">
    <table>
      <thead><tr><th>업무</th><th>Crew</th><th>상태</th><th>중요도</th><th>일정</th><th>참여자 (수락/전체)</th></tr></thead>
      <tbody>
        <% tasks.forEach((t) => { %>
          <tr>
            <td><a href="/tasks/<%= t.id %>"><%= t.title %></a><% if (t.type) { %> <span class="badge"><%= t.type.name %></span><% } %></td>
            <td><%= t.crew ? t.crew.name : '조직 업무' %></td>
            <td><span class="badge task-<%= t.status %>"><%= t.statusLabel %></span></td>
            <td><span class="badge prio-<%= t.priority %>"><%= t.priorityLabel %></span></td>
            <td class="small"><%= fmt(t.startAt) %> ~ <%= fmt(t.endAt) %></td>
            <td><%= t.acceptedCount %>/<%= t.assigneeCount %><%= t.requiredHeadcount ? ` (필요 ${t.requiredHeadcount})` : '' %></td>
          </tr>
        <% }) %>
        <% if (!tasks.length) { %><tr><td colspan="6" class="muted">조건에 맞는 업무가 없습니다.</td></tr><% } %>
      </tbody>
    </table>
  </div>
  <%- include('partials/pager', { meta }) %>
</section>

<% if (can('task.create')) { %>
  <section class="card">
    <h2>업무 등록 <span class="tag">FR-07</span></h2>
    <form method="post" action="/tasks">
      <div class="form-row">
        <label>제목 <input name="title" required maxlength="100"></label>
        <label>유형
          <select name="typeId"><option value="">없음</option><% types.forEach((t) => { %><option value="<%= t.id %>"><%= t.name %></option><% }) %></select>
        </label>
        <% if (me.role !== 'CAPO') { %>
          <label>Crew
            <select name="crewId"><option value="">조직 업무 (Crew 없음)</option><% crews.forEach((c) => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select>
          </label>
        <% } %>
        <label>중요도
          <select name="priority"><% Object.entries(C.TASK_PRIORITY_INFO).forEach(([key, info]) => { %><option value="<%= key %>" <%= key === 'MEDIUM' ? 'selected' : '' %>><%= info.label %></option><% }) %></select>
        </label>
      </div>
      <div class="form-row">
        <label>시작 <input name="startAt" type="datetime-local" required></label>
        <label>종료 <input name="endAt" type="datetime-local" required></label>
        <label>장소 <input name="location" maxlength="100"></label>
        <label>필요 인원 <input name="requiredHeadcount" type="number" min="1" max="100"></label>
        <label>설명 <input name="description" maxlength="2000"></label>
      </div>
      <button>등록</button>
      <p class="hint">시각은 한국 시간입니다. <%= me.role === 'CAPO' ? '업무는 자신이 책임자인 Crew의 업무로 만들어집니다.' : '' %> 등록한 업무는 계획 상태이며, 구성원을 배정한 뒤 시작할 수 있습니다.</p>
    </form>
  </section>
<% } %>
<%- include('partials/foot') %>
