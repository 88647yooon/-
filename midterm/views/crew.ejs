<%- include('partials/head') %>
<% const active = crew.status === 'ACTIVE'; %>
<% const crewAdmin = can('crew.update') || can('crew.capo.assign') || can('crew.underboss.assign') || can('crew.status.change') || can('crew.merge') || can('crew.delete'); %>
<%- include('partials/crumbs', { trail: [{ label: crew.name }] }) %>
<div class="page-head">
  <div>
    <h1><%= crew.name %> <span class="badge status-<%= crew.status %>"><%= crew.statusLabel %></span></h1>
    <p class="page-desc"><%= crew.region %> · <%= crew.description || '설명 없음' %></p>
  </div>
  <% if (crewAdmin) { %><div class="page-actions"><a class="button" href="#manage">Crew 관리</a></div><% } %>
</div>
<nav class="subnav">
  <a href="#overview">개요</a><a href="#members">소속원</a><a href="#join">소속 신청</a>
  <% if (crewAdmin) { %><a href="#manage">관리</a><% } %>
  <a href="#history">편성·책임자 이력</a><a href="#workload">업무량</a><a href="#activity">활동</a>
</nav>

<div class="cols" id="overview">
  <section class="card">
    <h2>Crew 정보</h2>
    <dl class="facts">
      <dt>책임자(Capo)</dt><dd><%- include('partials/who', { u: crew.capo }) %></dd>
      <dt>담당 Underboss</dt><dd><%- include('partials/who', { u: crew.underboss }) %></dd>
      <dt>인원</dt><dd>정식 <%= crew.regularCount %>명 · 임시 <%= crew.temporaryCount %>명</dd>
      <dt>만든 날</dt><dd><%= fmt(crew.createdAt) %></dd>
      <% if (crew.disbandedAt) { %><dt>해산일</dt><dd><%= fmt(crew.disbandedAt) %></dd><% } %>
    </dl>
  </section>

  <section class="card">
    <h2>조직도</h2>
    <% if (hierarchy.ok) { %>
      <% const tree = hierarchy.value.tree; const capoNode = tree.children[0]; %>
      <ul class="tree">
        <li><span class="pos">Underboss</span><%- include('partials/who', { u: tree.user }) %>
          <ul>
            <li><span class="pos">Capo</span><%- include('partials/who', { u: capoNode.user }) %>
              <ul>
                <% capoNode.children.forEach((m) => { %>
                  <li><span class="pos"><%= m.user.roleLabel %></span><%- include('partials/who', { u: m.user }) %><% if (m.membershipType === 'TEMPORARY') { %> <span class="badge">임시</span><% } %></li>
                <% }) %>
                <% if (!capoNode.children.length) { %><li class="muted">소속원 없음</li><% } %>
              </ul>
            </li>
          </ul>
        </li>
      </ul>
    <% } else { %><p class="denied"><%= hierarchy.message %></p><% } %>
  </section>
</div>

<section class="card" id="members">
  <h2>현재 소속원</h2>
  <% if (members.ok) { %>
    <% const canManage = active && can('crew.members.manage'); const canTransfer = active && can('crew.members.transfer'); %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>구성원</th><th>역할</th><th>상태</th><th>유형</th><th>가입</th><th>연락처</th><% if (canManage) { %><th>관리</th><% } %></tr></thead>
        <tbody>
          <% members.value.data.forEach((m) => { %>
            <tr>
              <td><%- include('partials/who', { u: m.user }) %><% if (m.isCapo) { %> <span class="badge role">책임자</span><% } %></td>
              <td><%= m.user.roleLabel %></td>
              <td><span class="badge status-<%= m.user.status %>"><%= m.user.statusLabel %></span></td>
              <td><%= m.typeLabel %></td>
              <td class="small"><%= fmt(m.joinedAt) %><br><span class="muted"><%= m.joinMethodLabel %><%= m.fromCrew ? ' ← ' + m.fromCrew.name : '' %></span></td>
              <td class="small"><%= 'phone' in m.user ? (m.user.phone || '-') : '비공개' %></td>
              <% if (canManage) { %>
                <td>
                  <form method="post" action="/crews/<%= crew.id %>/members/<%= m.user.id %>/type">
                    <input type="hidden" name="type" value="<%= m.type === 'REGULAR' ? 'TEMPORARY' : 'REGULAR' %>">
                    <button class="ghost small"><%= m.type === 'REGULAR' ? '임시로' : '정식으로' %></button>
                  </form>
                  <form method="post" action="/crews/<%= crew.id %>/members/<%= m.user.id %>/remove"><button class="ghost small">제외</button></form>
                  <% if (canTransfer && otherCrews.length) { %>
                    <form method="post" action="/crews/<%= crew.id %>/members/<%= m.user.id %>/transfer">
                      <select name="targetCrewId"><% otherCrews.forEach((c) => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select>
                      <button class="ghost small">이동</button>
                    </form>
                  <% } %>
                </td>
              <% } %>
            </tr>
          <% }) %>
          <% if (!members.value.data.length) { %><tr><td colspan="7" class="muted">소속원이 없습니다.</td></tr><% } %>
        </tbody>
      </table>
    </div>
    <% if (canManage) { %>
      <p class="hint">책임자는 책임자 지정을 해제한 뒤 제외·이동할 수 있습니다. 다른 Crew로 이동은 Underboss·Boss만 할 수 있습니다.</p>
    <% } %>
  <% } else { %><p class="denied"><%= members.message %></p><% } %>
</section>

<% if (active && can('crew.members.manage')) { %>
  <section class="card">
    <h2>구성원 편성</h2>
    <form method="post" action="/crews/<%= crew.id %>/members" class="form-row">
      <label>아이디 <input name="username" required placeholder="예: associate2"></label>
      <label>유형
        <select name="type"><% Object.entries(C.MEMBERSHIP_TYPE_INFO).forEach(([key, info]) => { %><option value="<%= key %>"><%= info.label %></option><% }) %></select>
      </label>
      <label>메모 <input name="note" maxlength="200"></label>
      <button>편성</button>
    </form>
    <p class="hint">
      활동중인 Associate·Soldier·Capo만 편성할 수 있습니다. 정식 소속은 한 Crew만 가능하므로 다른 Crew에 정식 소속된 구성원은 임시로만 편성할 수 있습니다.
      Capo는 자신이 책임자인 Crew에만 편성할 수 있습니다.
    </p>
  </section>
<% } %>

<section class="card" id="join">
  <h2>소속 신청</h2>
  <% if (isMember) { %>
    <p class="muted">이미 이 Crew의 소속원입니다.</p>
  <% } else if (active && can('crew.joinRequest.apply')) { %>
    <form method="post" action="/crews/<%= crew.id %>/join" class="form-row">
      <label>유형
        <select name="type"><% Object.entries(C.MEMBERSHIP_TYPE_INFO).forEach(([key, info]) => { %><option value="<%= key %>"><%= info.label %></option><% }) %></select>
      </label>
      <label>하고 싶은 말 <input name="message" maxlength="500" placeholder="이 Crew에서 활동하고 싶습니다."></label>
      <button>이 Crew에 소속 신청</button>
    </form>
    <p class="hint">정식 소속은 한 Crew만 가능합니다. 내 신청 현황은 내 정보에서 볼 수 있습니다.</p>
  <% } %>

  <% if (joinRequests.ok) { %>
    <h3>들어온 신청</h3>
    <% if (joinRequests.value.data.length) { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>신청자</th><th>유형</th><th>하고 싶은 말</th><th>상태</th><th>신청일</th><th>처리</th></tr></thead>
          <tbody>
            <% joinRequests.value.data.forEach((r) => { %>
              <tr>
                <td><%- include('partials/who', { u: r.applicant }) %></td>
                <td><%= r.typeLabel %></td>
                <td class="small"><%= r.message || '-' %></td>
                <td><span class="badge"><%= r.statusLabel %></span></td>
                <td><%= fmt(r.createdAt) %></td>
                <td>
                  <% if (r.status === 'PENDING') { %>
                    <form method="post" action="/crews/<%= crew.id %>/join-requests/<%= r.id %>/approve"><button class="small">승인</button></form>
                    <form method="post" action="/crews/<%= crew.id %>/join-requests/<%= r.id %>/reject">
                      <input name="reason" required placeholder="거절 사유" maxlength="500">
                      <button class="ghost small">거절</button>
                    </form>
                  <% } else { %>
                    <span class="small muted"><%= r.decidedBy ? r.decidedBy.name : '' %> <%= fmt(r.decidedAt) %><%= r.decisionReason ? ' · ' + r.decisionReason : '' %></span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <p class="hint">승인할 때 편성 조건을 다시 확인합니다.</p>
    <% } else { %><p class="muted">들어온 신청이 없습니다.</p><% } %>
  <% } else { %><p class="denied">들어온 신청: <%= joinRequests.message %></p><% } %>
</section>

<% if (crewAdmin) { %>
  <section class="card" id="manage">
    <h2>Crew 관리</h2>
    <div class="forms">
      <% if (active && can('crew.update')) { %>
        <form method="post" action="/crews/<%= crew.id %>/edit">
          <h3>정보 수정</h3>
          <div class="form-row">
            <label>이름 <input name="name" maxlength="50" placeholder="<%= crew.name %>"></label>
            <label>지역 <input name="region" maxlength="50" placeholder="<%= crew.region %>"></label>
            <label>설명 <input name="description" maxlength="500" placeholder="<%= crew.description || '' %>"></label>
          </div>
          <button>수정</button>
          <p class="hint">입력한 항목만 바뀝니다. Capo는 자신이 책임자인 Crew만 수정할 수 있습니다.</p>
        </form>
      <% } %>
      <% if (active && can('crew.capo.assign')) { %>
        <div>
          <form method="post" action="/crews/<%= crew.id %>/capo">
            <h3>책임자(Capo) 지정·교체</h3>
            <div class="form-row">
              <label>아이디 <input name="username" required placeholder="Capo 역할 구성원"></label>
              <label>사유 <input name="reason" maxlength="500"></label>
            </div>
            <button>지정</button>
            <p class="hint">활동중인 Capo만 지정할 수 있습니다. 정식 소속이 없으면 이 Crew에 정식으로 함께 편성되고, 다른 Crew에 정식 소속된 Capo는 지정할 수 없습니다.</p>
          </form>
          <% if (crew.capo) { %>
            <form method="post" action="/crews/<%= crew.id %>/capo/remove"><button class="ghost small">현재 책임자 해제</button></form>
          <% } %>
        </div>
      <% } %>
      <% if (active && can('crew.underboss.assign')) { %>
        <form method="post" action="/crews/<%= crew.id %>/underboss">
          <h3>담당 Underboss 지정</h3>
          <div class="form-row"><label>아이디 <input name="username" required placeholder="예: underboss2"></label></div>
          <button>지정</button>
          <p class="hint">Boss만 할 수 있고, 활동중인 Underboss 역할만 지정할 수 있습니다.</p>
        </form>
      <% } %>
      <% if (can('crew.status.change')) { %>
        <form method="post" action="/crews/<%= crew.id %>/status">
          <h3><%= active ? 'Crew 해산' : 'Crew 다시 활성화' %></h3>
          <input type="hidden" name="status" value="<%= active ? 'DISBANDED' : 'ACTIVE' %>">
          <div class="form-row"><label>사유 <input name="reason" maxlength="500"></label></div>
          <button class="<%= active ? 'danger' : '' %>"><%= active ? '해산' : '활성화' %></button>
          <% if (active) { %><p class="hint">해산하면 모든 소속이 끝나고, 책임자·담당 Underboss 지정이 풀리며, 대기 중인 소속 신청이 취소됩니다.</p><% } %>
        </form>
      <% } %>
      <% if (active && can('crew.merge') && otherCrews.length) { %>
        <form method="post" action="/crews/<%= crew.id %>/merge">
          <h3>다른 Crew에 병합</h3>
          <div class="form-row">
            <label>합칠 대상 Crew
              <select name="targetCrewId"><% otherCrews.forEach((c) => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select>
            </label>
            <label>사유 <input name="reason" maxlength="500"></label>
          </div>
          <button class="danger">병합</button>
          <p class="hint">이 Crew의 모든 소속원을 대상 Crew로 옮기고 이 Crew는 해산합니다.</p>
        </form>
      <% } %>
      <% if (can('crew.delete')) { %>
        <form method="post" action="/crews/<%= crew.id %>/delete">
          <h3>삭제</h3>
          <button class="danger">Crew 삭제</button>
          <p class="hint">편성·신청·책임자 기록이 하나도 없는 Crew만 삭제됩니다. 그 밖에는 해산하세요.</p>
        </form>
      <% } %>
    </div>
  </section>
<% } %>

<div id="history">
  <section class="card">
    <h2>편성 이력</h2>
    <% if (history.ok) { %>
      <% if (history.value.data.length) { %>
        <div class="table-wrap">
          <table>
            <thead><tr><th>구성원</th><th>유형</th><th>시작</th><th>종료</th><th>처리자</th></tr></thead>
            <tbody>
              <% history.value.data.forEach((m) => { %>
                <tr>
                  <td><%- include('partials/who', { u: m.user }) %></td>
                  <td><%= m.typeLabel %></td>
                  <td class="small"><%= fmt(m.joinedAt) %><br><span class="muted"><%= m.joinMethodLabel %></span></td>
                  <td class="small"><%= m.active ? '현재 소속' : fmt(m.leftAt) %><% if (!m.active) { %><br><span class="muted"><%= m.endReasonLabel %><%= m.toCrew ? ' → ' + m.toCrew.name : '' %></span><% } %></td>
                  <td class="small"><%= m.endedBy ? m.endedBy.name : (m.addedBy ? m.addedBy.name : '-') %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %><p class="muted">편성 기록이 없습니다.</p><% } %>
    <% } else { %><p class="denied"><%= history.message %></p><% } %>
  </section>

  <section class="card">
    <h2>책임자 이력</h2>
    <% if (capoHistory.ok) { %>
      <% if (capoHistory.value.data.length) { %>
        <table>
          <thead><tr><th>책임자</th><th>시작</th><th>종료</th><th>지정한 사람</th></tr></thead>
          <tbody>
            <% capoHistory.value.data.forEach((term) => { %>
              <tr>
                <td><%- include('partials/who', { u: term.capo }) %></td>
                <td class="small"><%= fmt(term.startedAt) %></td>
                <td class="small"><%= term.active ? '현재' : fmt(term.endedAt) + ' · ' + term.endReasonLabel %></td>
                <td class="small"><%= term.assignedBy ? term.assignedBy.name : '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %><p class="muted">책임자 기록이 없습니다.</p><% } %>
    <% } else { %><p class="denied"><%= capoHistory.message %></p><% } %>
  </section>
</div>

<section class="card" id="workload">
  <h2>소속원별 업무량 (앞으로 2주)</h2>
  <% if (workload.ok) { %>
    <% if (workload.value.members.length) { %>
      <table>
        <thead><tr><th>구성원</th><th>배정 업무</th><th>끝나지 않은 업무</th><th>리더</th><th>업무 시간</th><th>다음 업무</th></tr></thead>
        <tbody>
          <% workload.value.members.forEach((m) => { %>
            <tr><td><a href="/users/<%= m.user.id %>"><%= m.user.name %></a> <span class="muted small"><%= m.user.roleLabel %><%= m.membershipType === 'TEMPORARY' ? ' · 임시' : '' %></span></td>
              <td class="mono"><%= m.taskCount %></td><td class="mono"><%= m.openCount %></td><td class="mono"><%= m.leaderCount %></td><td class="mono"><%= m.hours %>h</td>
              <td class="small"><%= m.nextStartAt ? fmt(m.nextStartAt) : '-' %></td></tr>
          <% }) %>
        </tbody>
      </table>
      <p class="hint">업무 시간이 많은 순입니다. 취소된 업무는 세지 않습니다.</p>
    <% } else { %><p class="muted">소속원이 없습니다.</p><% } %>
  <% } else { %><p class="denied"><%= workload.message %></p><% } %>
</section>

<section class="card" id="activity">
  <h2>Crew 활동</h2>
  <% if (activity.ok) { %>
    <% if (activity.value.data.length) { %>
      <ul class="feed">
        <% activity.value.data.forEach((a) => { %>
          <li><span class="time"><%= fmt(a.at) %></span> <span class="badge"><%= a.actionLabel %></span>
            <%= a.target.label || `${a.target.entity}#${a.target.id}` %><%= a.related.length ? ' · ' + a.related.map((r) => r.label || r.entity).join(', ') : '' %>
            <span class="small muted"><%= a.actor ? '— ' + a.actor.username : '' %><%= a.reason ? ' · ' + a.reason : '' %></span></li>
        <% }) %>
      </ul>
      <p class="hint">Crew·소속 변경과 이 Crew 업무의 활동·평가 기록 최근 30건입니다.</p>
    <% } else { %><p class="muted">활동 기록이 없습니다.</p><% } %>
  <% } else { %><p class="denied"><%= activity.message %></p><% } %>
</section>
<%- include('partials/foot') %>
