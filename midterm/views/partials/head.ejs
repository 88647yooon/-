<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · The Family</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="brand" href="/">The Family<span>통합 정보시스템</span></a>
    <nav class="nav">
      <a href="/" class="<%= path === '/' ? 'on' : '' %>">홈</a>
      <% if (me) { %>
        <a href="/me" class="<%= path === '/me' ? 'on' : '' %>">내 정보</a>
        <% if (can('user.list')) { %><a href="/users" class="<%= path.startsWith('/users') ? 'on' : '' %>">구성원</a><% } %>
        <a href="/crews" class="<%= path.startsWith('/crews') ? 'on' : '' %>">Crew</a>
        <% if (can('task.list')) { %><a href="/tasks" class="<%= path.startsWith('/tasks') ? 'on' : '' %>">업무</a><% } %>
        <% if (can('task.participate')) { %><a href="/my-tasks" class="<%= path === '/my-tasks' ? 'on' : '' %>">내 업무</a><% } %>
        <% if (can('resource.read')) { %><a href="/resources" class="<%= path.startsWith('/resources') ? 'on' : '' %>">자원</a><% } %>
        <% if (can('resource.use')) { %><a href="/my-resources" class="<%= path === '/my-resources' ? 'on' : '' %>">내 자원</a><% } %>
        <% if (can('roleRequest.read')) { %><a href="/role-requests" class="<%= path.startsWith('/role-requests') ? 'on' : '' %>">역할 변경 요청</a><% } %>
      <% } %>
      <a href="/api-docs">API 문서(Swagger)</a>
    </nav>
    <div class="who">
      <% if (me) { %>
        <span><%= me.name %> <span class="badge role"><%= me.roleLabel %></span></span>
        <form method="post" action="/logout"><button class="link">로그아웃</button></form>
      <% } else { %>
        <a class="button small" href="/login">로그인</a>
      <% } %>
    </div>
  </div>
</header>
<main class="wrap">
<%- include('flash') %>
