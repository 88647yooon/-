<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · The Family 통합 정보시스템</title>
  <link rel="stylesheet" href="/style.css">
</head>
<% if (me) { %>
<body class="app">
<input type="checkbox" id="nav-open" class="nav-open" aria-hidden="true" tabindex="-1">
<aside class="sidebar">
  <a class="brand" href="/">
    <span class="brand-mark">TF</span>
    <span class="brand-name">The Family<small>통합 정보시스템</small></span>
  </a>
  <nav class="side-nav" aria-label="주 메뉴">
    <% nav.forEach((g) => { %>
      <% if (g.label) { %><div class="side-group"><%= g.label %></div><% } %>
      <% g.items.forEach((item) => { %>
        <a href="<%= item.href %>" class="<%= current && current.item.href === item.href ? 'on' : '' %>"<%- current && current.item.href === item.href ? ' aria-current="page"' : '' %>><%- include('icon', { name: item.icon }) %><span><%= item.label %></span></a>
      <% }) %>
    <% }) %>
  </nav>
  <div class="side-foot">
    <a href="/api-docs"><%- include('icon', { name: 'code' }) %><span>API 문서</span></a>
  </div>
</aside>
<label for="nav-open" class="scrim" aria-hidden="true"></label>
<div class="shell">
  <header class="appbar">
    <label for="nav-open" class="icon-btn menu-btn" title="메뉴"><%- include('icon', { name: 'menu' }) %></label>
    <% if (can('search.use')) { %>
      <form class="global-search" method="get" action="/search" role="search">
        <%- include('icon', { name: 'search' }) %>
        <input name="q" placeholder="구성원·Crew·업무·자원 검색" aria-label="통합 검색" value="<%= path === '/search' && locals.query && query.q ? query.q : '' %>">
      </form>
    <% } else { %><div class="appbar-spacer"></div><% } %>
    <details class="user-menu">
      <summary>
        <span class="avatar"><%= me.name.slice(0, 1) %></span>
        <span class="user-name"><%= me.name %><small><%= me.roleLabel %></small></span>
      </summary>
      <div class="menu-pop">
        <div class="menu-head"><strong><%= me.name %></strong><span>@<%= me.username %> · <%= me.roleLabel %></span></div>
        <a href="/me"><%- include('icon', { name: 'user' }) %>내 정보</a>
        <% if (me.role !== 'ADMIN') { %><a href="/users/<%= me.id %>"><%- include('icon', { name: 'file' }) %>내 기록·평판</a><% } %>
        <form method="post" action="/logout"><button class="menu-item"><%- include('icon', { name: 'logout' }) %>로그아웃</button></form>
      </div>
    </details>
  </header>
  <main class="content">
<% } else { %>
<body class="guest">
<main class="guest-main">
<% } %>
<%- include('flash') %>
