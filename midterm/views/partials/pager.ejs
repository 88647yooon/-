<% if (meta) { %>
  <div class="pager">
    <span class="pager-total">총 <strong><%= meta.total %></strong>건</span>
    <span class="pager-nav">
      <% if (meta.page > 1) { %><a href="<%= pageUrl(meta.page - 1) %>">‹ 이전</a><% } else { %><span class="off">‹ 이전</span><% } %>
      <span><%= meta.page %> / <%= Math.max(meta.totalPages, 1) %></span>
      <% if (meta.page < meta.totalPages) { %><a href="<%= pageUrl(meta.page + 1) %>">다음 ›</a><% } else { %><span class="off">다음 ›</span><% } %>
    </span>
  </div>
<% } %>
