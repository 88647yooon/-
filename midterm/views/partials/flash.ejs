<% if (flash) { %>
  <% const ruleCode = flash.rule || (/^BR-\d+$/.test(flash.code || '') ? flash.code : null); %>
  <div class="flash <%= flash.type %>" role="<%= flash.type === 'error' ? 'alert' : 'status' %>">
    <p><%= flash.message %><% if (ruleCode) { %> <span class="flash-code">규정 <%= ruleCode %></span><% } %></p>
    <% if (flash.details && flash.details.length) { %>
      <ul>
        <% flash.details.forEach((d) => { %>
          <li><%= String(d.field || '').replace(/^(form|body|query|params)\./, '') %>: <%= d.message %></li>
        <% }) %>
      </ul>
    <% } %>
  </div>
<% } %>
