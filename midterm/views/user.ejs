<%- include('partials/head') %>
<% const manage = can('user.update') || can('user.role.change') || can('user.status.change') || can('roleRequest.create') || can('user.delete'); %>
<%- include('partials/crumbs', { trail: [{ label: user.name }] }) %>
<div class="page-head">
  <div>
    <h1><%= user.name %> <span class="badge role"><%= user.roleLabel %></span> <span class="badge status-<%= user.status %>"><%= user.statusLabel %></span></h1>
    <p class="page-desc">@<%= user.username %><%= user.currentMemberships.length ? ' · ' + user.currentMemberships.map((m) => m.crew.name + (m.type === 'TEMPORARY' ? '(임시)' : '')).join(', ') : '' %></p>
  </div>
  <% if (manage && me.id !== user.id) { %><div class="page-actions"><a class="button" href="#manage">구성원 관리</a></div><% } %>
</div>
<nav class="subnav">
  <a href="#overview">개요</a><a href="#memberships">소속 이력</a><a href="#reputation">평판·평가</a><a href="#changes">변경 이력</a><a href="#activity">활동</a>
  <% if (manage && me.id !== user.id) { %><a href="#manage">관리</a><% } %>
</nav>

<div class="cols" id="overview">
  <section class="card">
    <h2>기본 정보</h2>
    <dl class="facts">
      <dt>역할</dt><dd><span class="badge role"><%= user.roleLabel %></span></dd>
      <dt>상태</dt><dd><span class="badge status-<%= user.status %>"><%= user.statusLabel %></span></dd>
      <dt>별명</dt><dd><%= user.nickname || '-' %></dd>
      <% if ('phone' in user) { %>
        <dt>전화번호</dt><dd><%= user.phone || '-' %></dd>
        <dt>이메일</dt><dd><%= user.email || '-' %></dd>
      <% } %>
      <% if (user.visibility === 'full') { %>
        <dt>마지막 로그인</dt><dd><%= fmt(user.lastLoginAt) %></dd>
        <dt>등록일</dt><dd><%= fmt(user.createdAt) %></dd>
      <% } %>
    </dl>
    <% if (user.visibility === 'basic') { %><p class="hint">연락처와 계정 정보는 공개되지 않습니다.</p><% } %>
  </section>

  <section class="card">
    <h2>현재 소속</h2>
    <% if (user.currentMemberships.length) { %>
      <ul>
        <% user.currentMemberships.forEach((m) => { %>
          <li><a href="/crews/<%= m.crew.id %>"><%= m.crew.name %></a> <span class="badge"><%= m.typeLabel %></span> <span class="muted small"><%= fmt(m.joinedAt) %>부터</span></li>
        <% }) %>
      </ul>
    <% } else { %><p class="muted">소속된 Crew가 없습니다.</p><% } %>
    <h3>맡은 Crew</h3>
    <% if (user.leadership.capoOf) { %><p>책임자: <a href="/crews/<%= user.leadership.capoOf.id %>"><%= user.leadership.capoOf.name %></a></p><% } %>
    <% if (user.leadership.underbossOf.length) { %>
      <p>담당 Underboss: <% user.leadership.underbossOf.forEach((c, i) => { %><%= i ? ', ' : '' %><a href="/crews/<%= c.id %>"><%= c.name %></a><% }) %></p>
    <% } %>
    <% if (!user.leadership.capoOf && !user.leadership.underbossOf.length) { %><p class="muted">없음</p><% } %>
  </section>
</div>

<div class="cols">
  <section class="card">
    <h2>상위 지휘 계통</h2>
    <% if (chain.ok) { %>
      <% if (chain.value.chain.length) { %>
        <ol>
          <% chain.value.chain.forEach((c) => { %><li><span class="badge"><%= c.levelLabel %></span> <%- include('partials/who', { u: c.user }) %></li><% }) %>
        </ol>
      <% } else { %><p class="muted">상위 지휘 계통이 없습니다.</p><% } %>
    <% } else { %><p class="denied"><%= chain.message %></p><% } %>
  </section>

  <section class="card">
    <h2>지휘 하위 구성원</h2>
    <% if (subordinates.ok) { %>
      <% if (subordinates.value.data.length) { %>
        <table>
          <thead><tr><th>구성원</th><th>역할</th><th>Crew</th><th>관계</th></tr></thead>
          <tbody>
            <% subordinates.value.data.forEach((s) => { %>
              <tr>
                <td><%- include('partials/who', { u: s.user }) %></td>
                <td><%= s.user.roleLabel %></td>
                <td><%= s.user.crew ? s.user.crew.name : '-' %></td>
                <td class="small"><%= { ORGANIZATION: '조직 전체', CREW_CAPO: 'Crew 책임자', CREW_MEMBER: 'Crew 소속원' }[s.relation] %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <p class="hint">총 <%= subordinates.value.meta.total %>명<%= subordinates.value.meta.total > subordinates.value.data.length ? ' (처음 ' + subordinates.value.data.length + '명 표시)' : '' %></p>
      <% } else { %><p class="muted">지휘 하위 구성원이 없습니다.</p><% } %>
    <% } else { %><p class="denied"><%= subordinates.message %></p><% } %>
  </section>
</div>

<section class="card" id="memberships">
  <h2>소속 이력</h2>
  <% if (memberships.ok) { %>
    <% if (memberships.value.data.length) { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Crew</th><th>유형</th><th>시작 경위</th><th>시작</th><th>종료</th><th>종료 이유</th><th>처리자</th></tr></thead>
          <tbody>
            <% memberships.value.data.forEach((m) => { %>
              <tr>
                <td><a href="/crews/<%= m.crew.id %>"><%= m.crew.name %></a><%= m.fromCrew ? ` ← ${m.fromCrew.name}` : '' %></td>
                <td><%= m.typeLabel %></td>
                <td class="small"><%= m.joinMethodLabel %></td>
                <td><%= fmt(m.joinedAt) %></td>
                <td><%= m.active ? '현재 소속' : fmt(m.leftAt) %></td>
                <td class="small"><%= m.endReasonLabel || '-' %><%= m.toCrew ? ` → ${m.toCrew.name}` : '' %></td>
                <td class="small"><%= m.endedBy ? m.endedBy.name : (m.addedBy ? m.addedBy.name : '-') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %><p class="muted">소속 기록이 없습니다.</p><% } %>
  <% } else { %><p class="denied"><%= memberships.message %></p><% } %>
</section>

<div class="cols" id="reputation">
  <section class="card">
    <h2>평판</h2>
    <% if (reputation.ok) { const r = reputation.value; %>
      <p><span class="big"><%= r.reputationScore %></span> / 100
        <span class="muted small">· 유효 평가 <%= r.evaluations.count %>건, 평균 <%= r.evaluations.averageScore ?? '-' %>점 · 공로·징계 <%= r.events.points > 0 ? '+' : '' %><%= r.events.points %>점</span></p>
      <% if (r.criteria.length) { %>
        <p class="small">항목별 평균: <%= r.criteria.map((c) => `${c.label} ${c.averageScore}`).join(', ') %></p>
      <% } %>
      <% if (r.trend.length) { %>
        <p class="small">월별 추세: <%= r.trend.map((m) => `${m.month} ${m.averageScore}점(${m.count})`).join(' · ') %></p>
      <% } %>
      <p class="hint"><%= r.formula %></p>
    <% } else { %><p class="denied"><%= reputation.message %></p><% } %>

    <h3>공로·징계</h3>
    <% if (events.ok) { %>
      <% if (events.value.data.length) { %>
        <ul class="feed">
          <% events.value.data.forEach((ev) => { %>
            <li class="<%= ev.active ? '' : 'muted' %>"><span class="badge <%= ev.points > 0 ? 'ok' : 'bad' %>"><%= ev.kindLabel %> <%= ev.points > 0 ? '+' : '' %><%= ev.points %></span>
              <%= ev.title %> <span class="small muted">— <%= ev.recordedBy ? ev.recordedBy.name : '' %>, <%= fmt(ev.createdAt) %></span>
              <% if (!ev.active) { %><span class="small">· 취소됨: <%= ev.cancelReason %></span><% } %>
              <% if (ev.active && can('reputation.record')) { %>
                <form method="post" action="/reputation-events/<%= ev.id %>/cancel"><input name="reason" required placeholder="취소 사유" size="10"><button class="ghost small">취소</button></form>
              <% } %>
            </li>
          <% }) %>
        </ul>
      <% } else { %><p class="muted">공로·징계 기록이 없습니다.</p><% } %>
    <% } else { %><p class="denied"><%= events.message %></p><% } %>
    <% if (can('reputation.record') && me.id !== user.id) { %>
      <form method="post" action="/users/<%= user.id %>/reputation-events" class="form-row">
        <select name="kind"><% Object.entries(C.REPUTATION_EVENT_KIND_INFO).forEach(([key, info]) => { %><option value="<%= key %>"><%= info.label %></option><% }) %></select>
        <input name="points" type="number" min="1" max="10" value="1" size="3" required>
        <input name="title" required maxlength="100" placeholder="제목">
        <input name="description" maxlength="500" placeholder="내용">
        <button class="small">기록</button>
      </form>
      <p class="hint">공로는 점수를 더하고 징계는 점수를 뺍니다. 자신과 같거나 높은 역할의 구성원에게는 기록할 수 없습니다.</p>
    <% } %>
  </section>

  <section class="card" id="evaluations">
    <h2>받은 평가</h2>
    <% if (evaluations.ok) { %>
      <% if (evaluations.value.data.length) { %>
        <table>
          <thead><tr><th>업무</th><th>점수</th><th>평가자</th><th>작성</th></tr></thead>
          <tbody>
            <% evaluations.value.data.forEach((e) => { %>
              <tr class="<%= e.status === 'WITHDRAWN' ? 'dim' : '' %>">
                <td><a href="/evaluations/<%= e.id %>"><%= e.task.title %></a><%= e.status === 'WITHDRAWN' ? ' (철회)' : '' %></td>
                <td><strong><%= e.totalScore %></strong><%= e.revisionCount ? ` · 수정 ${e.revisionCount}` : '' %></td>
                <td class="small"><%= e.evaluator.name %></td>
                <td class="small"><%= fmt(e.createdAt) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <% if (me.id === user.id) { %><p class="hint">평가를 누르면 항목별 점수와 수정 이력을 보고 이의를 제기할 수 있습니다.</p><% } %>
      <% } else { %><p class="muted">받은 평가가 없습니다.</p><% } %>
    <% } else { %><p class="denied"><%= evaluations.message %></p><% } %>
  </section>
</div>

<section class="card" id="changes">
  <h2>변경 이력</h2>
  <% if (changes.ok) { %>
    <% if (changes.value.data.length) { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>시각</th><th>유형</th><th>내용</th><th>처리자</th><th>사유</th></tr></thead>
          <tbody>
            <% changes.value.data.forEach((h) => { %>
              <tr><td class="small"><%= fmt(h.at) %></td><td><span class="badge"><%= h.typeLabel %></span></td><td><%= h.summary %></td>
                <td class="small"><%= h.actor ? h.actor.username : '시스템' %></td><td class="small"><%= h.reason || '' %></td></tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <p class="hint">역할·상태·소속·평가·공로·징계가 바뀐 기록을 시간순으로 보여 줍니다.</p>
    <% } else { %><p class="muted">변경 이력이 없습니다.</p><% } %>
  <% } else { %><p class="denied"><%= changes.message %></p><% } %>
</section>

<section class="card" id="activity">
  <h2>활동</h2>
  <% if (activity.ok) { %>
    <% if (activity.value.data.length) { %>
      <ul class="feed">
        <% activity.value.data.forEach((i) => { %>
          <li><span class="time"><%= fmt(i.at) %></span> <span class="badge"><%= i.typeLabel %></span>
            <% if (i.evaluationId) { %><a href="/evaluations/<%= i.evaluationId %>"><%= i.summary %></a><% } else if (i.task && i.kind === 'TASK') { %><a href="/tasks/<%= i.task.id %>"><%= i.summary %></a><% } else { %><%= i.summary %><% } %></li>
        <% }) %>
      </ul>
      <p class="hint">업무 배정·참여, 자원 사용, 받은 평가, 공로·징계의 최근 30건입니다.</p>
    <% } else { %><p class="muted">활동 기록이 없습니다.</p><% } %>
  <% } else { %><p class="denied"><%= activity.message %></p><% } %>
</section>

<% if (manage && me.id !== user.id) { %>
  <section class="card" id="manage">
    <h2>구성원 관리</h2>
    <p class="section-note muted">자신과 같거나 높은 역할의 구성원은 변경할 수 없고, Capo는 자기 Crew 소속원만 관리할 수 있습니다.</p>
    <div class="forms">
      <% if (can('user.update')) { %>
        <form method="post" action="/users/<%= user.id %>/basic">
          <h3>기본 정보 수정</h3>
          <div class="form-row">
            <label>이름 <input name="name" maxlength="50" placeholder="<%= user.name %>"></label>
            <label>별명 <input name="nickname" maxlength="50" placeholder="<%= user.nickname || '' %>"></label>
            <label>전화번호 <input name="phone" placeholder="010-0000-0000"></label>
            <label>이메일 <input name="email" type="email"></label>
          </div>
          <button>수정</button>
        </form>
      <% } %>
      <% if (can('user.role.change')) { %>
        <form method="post" action="/users/<%= user.id %>/role">
          <h3>역할 변경</h3>
          <div class="form-row">
            <label>새 역할
              <select name="role">
                <% Object.entries(C.ROLE_INFO).forEach(([key, info]) => { %><option value="<%= key %>" <%= key === user.role ? 'selected' : '' %>><%= info.label %></option><% }) %>
              </select>
            </label>
            <label>사유 <input name="reason" maxlength="500"></label>
          </div>
          <button>역할 변경</button>
          <p class="hint">자신보다 높은 역할로는 올릴 수 없고, Boss 지정·해제는 Boss만 할 수 있습니다.</p>
        </form>
      <% } %>
      <% if (can('user.status.change')) { %>
        <form method="post" action="/users/<%= user.id %>/status">
          <h3>상태 변경</h3>
          <div class="form-row">
            <label>새 상태
              <select name="status">
                <% Object.entries(C.MEMBER_STATUS_INFO).forEach(([key, info]) => { %><option value="<%= key %>" <%= key === user.status ? 'selected' : '' %>><%= info.label %></option><% }) %>
              </select>
            </label>
            <label>사유 <input name="reason" maxlength="500"></label>
          </div>
          <button>상태 변경</button>
          <% const next = C.MEMBER_STATUS_INFO[user.status].next; %>
          <p class="hint">지금(<%= user.statusLabel %>)에서 바꿀 수 있는 상태: <%= next.length ? next.map((s) => C.MEMBER_STATUS_INFO[s].label).join(', ') : '없음' %>. 정지·탈퇴하면 로그인 세션이 바로 끊기고, 탈퇴하면 모든 Crew 소속이 끝납니다.</p>
        </form>
      <% } %>
      <% if (can('roleRequest.create')) { %>
        <form method="post" action="/users/<%= user.id %>/role-request">
          <h3>역할 변경 추천</h3>
          <div class="form-row">
            <label>추천 역할
              <select name="role">
                <% Object.entries(C.ROLE_INFO).forEach(([key, info]) => { %><option value="<%= key %>"><%= info.label %></option><% }) %>
              </select>
            </label>
            <label>사유 <input name="reason" maxlength="500" required></label>
          </div>
          <button>추천</button>
          <p class="hint">Capo는 자기 Crew 소속원을 Associate·Soldier·Capo로만 추천할 수 있습니다. Underboss·Boss가 승인하면 반영됩니다.</p>
        </form>
      <% } %>
      <% if (can('user.delete')) { %>
        <form method="post" action="/users/<%= user.id %>/delete">
          <h3>삭제</h3>
          <button class="danger">구성원 삭제</button>
          <p class="hint">로그인한 적도, 소속·신청 기록도 없는 잘못 등록된 구성원만 삭제됩니다. 그 밖에는 상태를 탈퇴로 바꾸세요.</p>
        </form>
      <% } %>
    </div>
  </section>
<% } %>
<%- include('partials/foot') %>
