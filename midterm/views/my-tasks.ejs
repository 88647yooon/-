<%- include('partials/head') %>
<h1>내 업무 <span class="tag">FR-08 · FR-09</span></h1>

<section class="card">
  <h2>내게 배정된 업무</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>업무</th><th>Crew</th><th>상태</th><th>일정</th><th>내 역할</th><th>내 응답</th></tr></thead>
      <tbody>
        <% tasks.forEach(({ task, assignment }) => { %>
          <tr>
            <td><a href="/tasks/<%= task.id %>"><%= task.title %></a></td>
            <td><%= task.crew ? task.crew.name : '조직 업무' %></td>
            <td><span class="badge task-<%= task.status %>"><%= task.statusLabel %></span></td>
            <td class="small"><%= fmt(task.startAt) %> ~ <%= fmt(task.endAt) %></td>
            <td><%= assignment.roleLabel %></td>
            <td><span class="badge"><%= assignment.responseLabel %></span></td>
          </tr>
        <% }) %>
        <% if (!tasks.length) { %><tr><td colspan="6" class="muted">배정된 업무가 없습니다.</td></tr><% } %>
      </tbody>
    </table>
  </div>
  <p class="hint">업무를 누르면 나에게 온 지시사항, 체크리스트, 함께하는 참여자를 볼 수 있고 배정을 수락·거절할 수 있습니다.</p>
</section>

<section class="card">
  <h2>앞으로 2주 일정 <span class="tag">FR-09</span></h2>
  <% if (schedule.items.length) { %>
    <ul>
      <% schedule.items.forEach((i) => { %>
        <% if (i.kind === 'TASK') { %>
          <li><%= fmt(i.startAt) %> ~ <%= fmt(i.endAt) %> · <a href="/tasks/<%= i.taskId %>"><%= i.title %></a> <span class="muted small"><%= i.myRoleLabel %><%= i.location ? ' · ' + i.location : '' %></span>
            <% if (i.resources.length) { %><span class="small">· 자원: <%= i.resources.map((r) => r.name).join(', ') %></span><% } %></li>
        <% } else { %>
          <li><%= fmt(i.startAt) %> ~ <%= fmt(i.endAt) %> · <span class="badge">자원</span> <a href="/resources/<%= i.resource.id %>"><%= i.resource.name %></a>
            <span class="muted small"><%= i.purpose || '' %><%= i.inUse ? ' · 사용 중' : '' %></span></li>
        <% } %>
      <% }) %>
    </ul>
  <% } else { %><p class="muted">예정된 업무가 없습니다.</p><% } %>
</section>

<section class="card">
  <h2>업무 교대 요청 <span class="tag">FR-08</span></h2>
  <% if (swaps.length) { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>업무</th><th>교대</th><th>사유</th><th>상태</th><th>처리</th></tr></thead>
        <tbody>
          <% swaps.forEach((s) => { %>
            <tr>
              <td><a href="/tasks/<%= s.task.id %>"><%= s.task.title %></a></td>
              <td><%= s.from.name %> → <%= s.to.name %></td>
              <td class="small"><%= s.reason || '-' %></td>
              <td><span class="badge"><%= s.statusLabel %></span></td>
              <td>
                <% if (s.status === 'PENDING') { %>
                  <% if (can('task.swap.review')) { %><form method="post" action="/swap-requests/<%= s.id %>/approve"><button class="small">승인</button></form><% } %>
                  <% if (s.to.id === me.id || can('task.swap.review')) { %>
                    <form method="post" action="/swap-requests/<%= s.id %>/reject"><input name="reason" placeholder="거절 사유" size="10"><button class="ghost small">거절</button></form>
                  <% } %>
                  <% if (s.from.id === me.id) { %><form method="post" action="/swap-requests/<%= s.id %>/cancel"><button class="ghost small">요청 취소</button></form><% } %>
                <% } else { %>
                  <span class="small muted"><%= s.decidedBy ? s.decidedBy.name : '' %> <%= fmt(s.decidedAt) %><%= s.decisionReason ? ' · ' + s.decisionReason : '' %></span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <p class="hint">내가 보낸 요청, 내가 받은 요청, 내가 승인할 수 있는 요청(담당 Crew 업무)이 모두 보입니다. 승인할 때 받을 사람에게 배정 규칙(BR-02·BR-03)을 다시 검사합니다.</p>
  <% } else { %><p class="muted">교대 요청이 없습니다. 업무 화면에서 내 배정을 다른 구성원에게 넘기도록 요청할 수 있습니다.</p><% } %>
</section>
<%- include('partials/foot') %>
